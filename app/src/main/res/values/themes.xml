<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Tic_tac_toe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here -->
        <item name="buttonStyle">@style/CustomButton</item>
        <item name="materialButtonStyle">@style/CustomButton</item>
    </style>

    <style name="Theme.Tic_tac_toe" parent="Base.Theme.Tic_tac_toe">
        <!-- Inherit the base theme -->
    </style>

    <!-- Define the button style -->
    <style name="CustomButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>
